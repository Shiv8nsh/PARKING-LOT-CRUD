{
  "info": {
    "_postman_id": "parking-lot-crud-api-v1",
    "name": "Parking Lot & Vehicle Fee CRUD API",
    "description": "Ready-to-use Postman Collection for university evaluation testing all 5 Express.js & MongoDB CRUD operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. CREATE Vehicle (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicleNumber\": \"HR-26-AB-1234\",\n  \"vehicleType\": \"Car\",\n  \"ownerName\": \"Rahul Sharma\",\n  \"parkingFee\": 50,\n  \"status\": \"Parked\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/vehicles",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "vehicles"
          ]
        },
        "description": "Creates a new vehicle record in MongoDB Atlas. Returns HTTP 201 Created."
      },
      "response": []
    },
    {
      "name": "2. READ ALL Vehicles (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/vehicles",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "vehicles"
          ]
        },
        "description": "Fetches all vehicle records from MongoDB sorted by latest first. Returns HTTP 200 OK."
      },
      "response": []
    },
    {
      "name": "3. READ ONE Vehicle by ID (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/vehicles/:id",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "vehicles",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "",
              "description": "Paste the MongoDB _id of a vehicle here"
            }
          ]
        },
        "description": "Fetches a single vehicle record by its unique MongoDB _id. Returns HTTP 200 OK (or 404 if not found)."
      },
      "response": []
    },
    {
      "name": "4. UPDATE Vehicle by ID (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Exited\",\n  \"parkingFee\": 60\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/vehicles/:id",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "vehicles",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "",
              "description": "Paste the MongoDB _id of the vehicle to update here"
            }
          ]
        },
        "description": "Updates status and/or parkingFee of a vehicle by ID using findByIdAndUpdate. Returns HTTP 200 OK."
      },
      "response": []
    },
    {
      "name": "5. DELETE Vehicle by ID (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/vehicles/:id",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "vehicles",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "",
              "description": "Paste the MongoDB _id of the vehicle to delete here"
            }
          ]
        },
        "description": "Deletes a vehicle record from MongoDB by its _id using findByIdAndDelete. Returns HTTP 200 OK."
      },
      "response": []
    }
  ]
}
